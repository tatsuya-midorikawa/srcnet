<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Srcnet.Extraction</RootNamespace>
        <!-- 相互運用の宣言に P/Invoke を使う。境界の検証は SyntaxTree が担う -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Native.fs" />
        <Compile Include="Grammars.fs" />
        <Compile Include="GrammarVersions.fs" />
        <Compile Include="SyntaxTree.fs" />
        <Compile Include="Parsing.fs" />
        <Compile Include="Model.fs" />
        <Compile Include="LineScan.fs" />
        <Compile Include="CSyntax.fs" />
        <Compile Include="Extractor.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Srcnet.Core/Srcnet.Core.fsproj" />
        <ProjectReference Include="../Srcnet.Text/Srcnet.Text.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            tools/build_native.py が構築した共有ライブラリを出力へ複製する。
            未構築でも一致するファイルが無いだけで、ビルドは成功する。
            構文解析器が無い環境では構造グラフ（M1）の機能がそのまま動く。
        -->
        <Content Include="../../native/build/*srcnet_treesitter*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
