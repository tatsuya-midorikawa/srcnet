<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>srcnet</AssemblyName>
        <RootNamespace>Srcnet.Cli</RootNamespace>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Terminal.fs" />
        <Compile Include="Args.fs" />
        <Compile Include="Commands.fs" />
        <Compile Include="QueryOutput.fs" />
        <Compile Include="QueryCommands.fs" />
        <Compile Include="ExportCommands.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <!--
            対話的な HTML の雛形。外部 CDN を使わないため、CSS と JavaScript を含めて
            埋め込み資源として持つ（backlog 029）。
        -->
        <EmbeddedResource Include="assets/graph.html" LogicalName="Srcnet.Cli.Assets.graph.html" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Srcnet.Core/Srcnet.Core.fsproj" />
        <ProjectReference Include="../Srcnet.Text/Srcnet.Text.fsproj" />
        <ProjectReference Include="../Srcnet.Discovery/Srcnet.Discovery.fsproj" />
        <ProjectReference Include="../Srcnet.Extraction/Srcnet.Extraction.fsproj" />
        <ProjectReference Include="../Srcnet.Storage/Srcnet.Storage.fsproj" />
    </ItemGroup>

</Project>
